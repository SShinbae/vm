**/__tests__/
**/__mocks__/
coverage/
.jest/

# Documentation
docs/
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Git
.git/
.github/

# Misc
*.orig
.eslintcache
